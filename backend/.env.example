# Копируете этот файл в backend/.env и вписываете свои значения.
# Сам .env в git не попадает (он в .gitignore), и так должно остаться.

# --- База MySQL (у меня на Aiven) ---
DB_HOST=your-service.aivencloud.com
DB_PORT=14041
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
# База для npm test, её каждый раз создают с нуля. В имени обязательно "test"
TEST_DB_NAME=catalog_test

# --- Сервер ---
PORT=3000
# Куда ведут ссылки из писем и кнопка «Назад» со Stripe.
# У себя http://localhost:5173, на Render адрес сайта на Vercel.
# Если оставить пустым, всех будет кидать на localhost (проверено на себе)
FRONTEND_URL=http://localhost:5173

# --- Вход ---
# Длинная случайная строка, хотя бы 32 символа. Коротким паролем не надо
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
# На каком языке писать письма админу: ru, ro или en
ADMIN_LANG=ru

# --- Вход через Google. Необязательно: не заполните, кнопки Google не будет ---
GOOGLE_CLIENT_ID=

# --- Почта для «Забыли пароль?». Необязательно: без неё ссылка просто скрыта ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Пароль приложения Google, 16 букв подряд, без пробелов
SMTP_PASS=
MAIL_FROM=

# --- Stripe, тестовые ключи (начинаются с sk_test_) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mdl

# --- Можно не трогать ---
# Во сколько раз ослабить лимит запросов, 1 значит как есть
RATE_LIMIT_SCALE=1
# Сервер сам себя пингует, чтобы бесплатный Render не засыпал
KEEP_ALIVE_URL=
