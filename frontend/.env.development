# Этот файл закоммичен нарочно, секретов в нём нет.
# С ним локальный фронтенд берёт данные с бэкенда на Render,
# и проверяющему не нужны никакие пароли.
# "npm run dev:full" сам меняет адрес на http://localhost:3000.
VITE_API_URL=https://easydistribution-catalog.onrender.com

# Client ID Google, тот же, что в .env.production. Он публичный, это не пароль.
# Если его убрать, кнопки «Войти через Google» локально просто не будет.
VITE_GOOGLE_CLIENT_ID=183444845954-vgde8j892r2bsrvi5dubbm4t7kk9k15n.apps.googleusercontent.com
