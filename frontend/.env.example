# Для обычного запуска этот файл не нужен, адрес API уже лежит в .env.development.
# Хотите что-то поменять только у себя? Скопируйте в frontend/.env.local.
# Всё, что начинается с VITE_, попадает в браузер, так что пароли сюда не пишем.

# Адрес бэкенда (в npm run dev:full и так подставится http://localhost:3000)
VITE_API_URL=http://localhost:3000

# Client ID из Google Cloud Console. Можно не заполнять, тогда кнопки Google не будет
VITE_GOOGLE_CLIENT_ID=
